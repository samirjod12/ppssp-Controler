<Window x:Class="PSPReceiver.MappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key Mapping" Height="680" Width="420" WindowStartupLocation="CenterOwner"
        Background="#1E1F22" Foreground="#E6E6E6" FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Warning" Foreground="#FFB454" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset to defaults" Click="OnReset" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Save" Click="OnSave" Padding="18,6" Margin="0,0,8,0" IsDefault="False"/>
                <Button Content="Cancel" Click="OnCancel" Padding="14,6"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Click a key box, then press the key you want. Esc cancels." Foreground="#9AA0A6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel x:Name="Rows"/>
                <TextBlock Text="Analog dead zone" Foreground="#9AA0A6" Margin="0,14,0,2"/>
                <Slider x:Name="DeadZone" Minimum="0.05" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        ValueChanged="OnDeadZoneChanged"/>
                <TextBlock x:Name="DeadZoneText"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="PSPReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSP Receiver" Height="720" Width="580" MinWidth="540"
        Background="#1E1F22" Foreground="#E6E6E6" FontFamily="Segoe UI"
        Closing="OnClosing" Closed="OnClosed">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6E6E6"/></Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Margin" Value="0,2,16,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="PSP Receiver" FontSize="24" FontWeight="SemiBold" Foreground="#4C9AFF"/>
            <TextBlock Text="{Binding ServerStatus}" Style="{StaticResource Value}" Margin="0,4,0,12"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Start Server" Click="OnStart" IsEnabled="{Binding CanStart}"/>
                <Button Content="Stop Server" Click="OnStop" IsEnabled="{Binding IsRunning}"/>
                <Button Content="Disconnect Client" Click="OnDisconnect" IsEnabled="{Binding IsRunning}"/>
            </StackPanel>

            <TextBlock Text="Local IP address (type this on the phone)" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding LocalIp}" Style="{StaticResource Value}"/>

            <TextBlock Text="Port" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditPort}"
                     Width="100" HorizontalAlignment="Left" FontSize="16" Padding="4"/>

            <TextBlock Text="Pairing PIN" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Pin}" FontSize="26" FontFamily="Consolas" Foreground="#4C9AFF" Margin="0,0,16,0"/>
                <Button Content="New PIN" Click="OnNewPin" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Connected device" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding ClientName}" Style="{StaticResource Value}"/>

            <TextBlock Text="Connection status" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource Value}"/>

            <TextBlock Text="Inputs received" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding InputCount}" Style="{StaticResource Value}"/>

            <TextBlock Text="Currently held" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding ActiveInputs}" Style="{StaticResource Value}"/>

            <TextBlock Text="Output mode" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="mode" Content="Keyboard" IsChecked="{Binding IsKeyboardMode}"/>
                <RadioButton GroupName="mode" Content="Virtual Gamepad" IsChecked="{Binding IsGamepadMode}"
                             IsEnabled="{Binding GamepadAvailable}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Key Mapping..." Click="OnKeyMapping"/>
                <Button Content="Test Controller" Click="OnTestController"/>
            </StackPanel>
            <TextBlock Text="{Binding KeyConflictWarning}" Foreground="#FFB454" TextWrapping="Wrap" Margin="0,6,0,0"/>

            <TextBlock Text="Virtual gamepad status" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding GamepadStatus}" Style="{StaticResource Value}"/>

            <TextBlock Text="Options" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
                <CheckBox Content="Minimize to tray" IsChecked="{Binding MinimizeToTray}"/>
            </StackPanel>

            <TextBlock Text="Last event" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding LastEvent}" Style="{StaticResource Value}"/>
        </StackPanel>
    </ScrollViewer>
</Window>
